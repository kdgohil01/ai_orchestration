# Required AI and media APIs
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PEXELS_API_KEY=

# Required for YouTube review uploads, publishing, and analytics
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Publishing is private-review by default. Live scheduling needs both:
ALLOW_AUTO_PUBLISH=false
PUBLISH_TIMEZONE=Asia/Kolkata
PUBLISH_HOUR=18

# Fact-checking
FACT_CHECK_MIN_CONFIDENCE=80
# Comma-separated extra authoritative domains, if needed
TRUSTED_SOURCE_DOMAINS=

# Optional email notification
EMAIL_USER=
EMAIL_PASS=

# Runtime tuning
PYTHON_COMMAND=python
NETWORK_TIMEOUT_MS=30000
PROCESS_TIMEOUT_MS=1800000
