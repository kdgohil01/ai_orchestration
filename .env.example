# Required for content generation. Keep Gemini billing disabled and use only
# the configured eligible free-tier model. Never commit real values.
GEMINI_API_KEY=replace_with_free_tier_key
GEMINI_MODEL=gemini-2.5-flash
PEXELS_API_KEY=replace_with_pexels_key

# Required only for --publish or --review.
CLIENT_ID=replace_with_google_oauth_client_id
CLIENT_SECRET=replace_with_google_oauth_client_secret
REFRESH_TOKEN=replace_with_youtube_refresh_token

# Optional Gmail SMTP notifications. Use an app password, never your account password.
EMAIL_USER=you@example.com
EMAIL_PASS=replace_with_gmail_app_password

# Local-only orchestration settings.
ORCHESTRATION_DB_PATH=data/orchestration.db
TEMP_DIR=.local/temp
OUTPUT_DIR=output/jobs
LOG_DIR=logs
REPORT_DIR=reports/generated
DASHBOARD_PORT=4317
DASHBOARD_REFRESH_MS=2000
FFMPEG_PATH=
FFPROBE_PATH=
PUBLISH_HOUR_LOCAL=18
PUBLISH_TIMEZONE=Asia/Kolkata
MAX_JOB_ATTEMPTS=3
RETRY_BASE_SECONDS=300
RETRY_MAX_SECONDS=21600
LOCK_LEASE_MINUTES=180
