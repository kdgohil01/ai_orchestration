{
  "name": "deedlamp-ai-orchestration",
  "version": "2.1.0",
  "description": "Local-first, zero-paid-fallback YouTube production orchestration for DeedLamp.",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/*.test.js test/core.test.js",
    "check": "node --check short.js && node --check long.js && node --check orchestrator.js && node --check dashboard/server.js && node --check dashboard/public/app.js",
    "db:init": "node orchestrator.js init",
    "report": "node orchestrator.js report",
    "report:daily": "node orchestrator.js report --period=daily --write",
    "report:weekly": "node orchestrator.js report --period=weekly --write",
    "retry:due": "node orchestrator.js run-due",
    "upload:recover": "node orchestrator.js recover-upload",
    "short": "node short.js",
    "long": "node long.js",
    "short:dry": "node short.js --dry-run",
    "long:dry": "node long.js --dry-run",
    "verify:long-render": "node scripts/verify-long-render.js",
    "dashboard": "node dashboard/server.js",
    "dashboard:open": "node dashboard/server.js --open",
    "test:syntax": "npm run check",
    "smoke": "node smoke-test.js",
    "auth": "node get-token.js",
    "analytics:sync": "node scripts/sync-analytics.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2",
    "edge-tts-universal": "^1.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^173.0.0",
    "nodemailer": "^9.0.3",
    "open": "^11.0.0",
    "pexels": "^1.4.0"
  }
}
