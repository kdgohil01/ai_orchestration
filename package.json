{
  "name": "deedlamp-ai-orchestration",
  "version": "2.1.0",
  "description": "Evidence-led YouTube Shorts and mini-documentary production pipeline with private review by default.",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node index.js",
    "short": "node short.js",
    "long": "node long.js",
    "auth": "node get-token.js",
    "analytics:sync": "node scripts/sync-analytics.js",
    "test": "node --test test/core.test.js",
    "test:syntax": "node --check index.js && node --check short.js && node --check long.js",
    "smoke": "node smoke-test.js",
    "test:integration:short": "node short.js --dry-run",
    "test:integration:long": "node long.js --dry-run"
  },
  "keywords": ["youtube", "automation", "gemini", "ffmpeg", "documentary"],
  "author": "KD Gohil",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2",
    "edge-tts-universal": "^1.4.0",
    "googleapis": "^173.0.0",
    "nodemailer": "^9.0.3",
    "open": "^11.0.0",
    "pexels": "^1.4.0"
  }
}
